# pip-audit for the deep-scans workflow. pip-audit.txt is this plus every dependency, each pinned
# to an exact version and checksum. Rebuild it after editing (Python 3.12, like the workflow):
#   docker run --rm -v "$PWD":/w -w /w python:3.12-slim sh -c \
#     "pip install -q pip-tools && pip-compile --generate-hashes --allow-unsafe --strip-extras -o pip-audit.txt pip-audit.in"
# (--allow-unsafe also pins pip/setuptools: with checksums, pip refuses anything left unpinned)
pip-audit==2.10.1
