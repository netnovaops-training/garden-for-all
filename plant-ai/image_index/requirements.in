# Libraries for the image index. Edit THIS file, then rebuild requirements.txt (exact versions
# and checksums) with:
#   docker run --rm -v "$PWD":/w -w /w python:3.12-slim sh -c \
#     "pip install -q pip-tools && pip-compile --allow-unsafe --generate-hashes --strip-extras \
#      --extra-index-url https://download.pytorch.org/whl/cpu -o requirements.txt requirements.in"
#   numpy         the photo vectors and the cosine search (a matrix product)
#   Pillow        opens the photos (.webp, .jpg) and shrinks them
#   torch         runs the model on the CPU (the CPU-only build, no CUDA)
#   torchvision   needed by open_clip_torch (CPU build, same family as torch)
#   transformers  loads the open model (DINOv2 / SigLIP / CLIP) from local files
#   timm          loads the PlantCLEF-2024 plant model (a DINOv2 ViT-B/14 trained on plants)
#   open_clip_torch  loads BioCLIP / BioCLIP 2 (which can also read a botanical name as text)
numpy==2.5.4
Pillow==13.0.0
torch==2.14.1
torchvision==0.29.1
transformers==5.21.0
timm==1.0.30
open_clip_torch==3.3.0
