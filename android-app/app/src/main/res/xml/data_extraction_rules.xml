<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- The scan queue's pictures (ScanStore.kt) are the garden's private photos: not in a cloud
         backup, and not copied to a new phone either (unsent scans are sent from the old one). -->
    <cloud-backup>
        <exclude domain="file" path="scanq" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="scanq" />
    </device-transfer>
</data-extraction-rules>