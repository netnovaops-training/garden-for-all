# --- Android ---
*.iml
.gradle/
build/
captures/
.externalNativeBuild/
.cxx/

# local.properties holds sdk.dir, which is this machine's path and nobody
# else's. It is also the file Android Studio regenerates, so committing it
# guarantees a conflict on every clone.
local.properties

# --- Xcode / iOS ---
# The .xcodeproj is GENERATED by XcodeGen from ios/project.yml, so it is a
# build output, not source. Committing it is how the yml and the project
# drift apart and the CI build stops matching what anyone sees locally.
ios/*.xcodeproj/
ios/*.xcworkspace/
DerivedData/
*.xcuserstate
xcuserdata/
.swiftpm/
*.ipa
*.dSYM.zip
*.dSYM

# --- keys and secrets, none of which belong in a repo that CI can read ---
*.keystore
*.jks
*.p12
*.mobileprovision
*.cer
.env
.env.*

# --- editor / OS noise ---
.idea/
.DS_Store
Thumbs.db

# Kotlin compiler caches
.kotlin/
